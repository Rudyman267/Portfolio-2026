# Sanity — fill these in after running `npx sanity@latest init`
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only token for draft preview & on-demand revalidation (Editor read access)
SANITY_API_READ_TOKEN=

# Secret used to verify the Sanity → /api/revalidate webhook
SANITY_REVALIDATE_SECRET=

# Public site URL (used for sitemap, canonical, OG). Update when custom domain added.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
