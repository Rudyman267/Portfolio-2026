# Production deployment with /flytbase-app-template/ base path
# These rules are checked first (more specific)
/flytbase-app-template/assets/*  /assets/:splat  200
/flytbase-app-template/*.js      /:splat.js      200
/flytbase-app-template/*.css     /:splat.css     200
/flytbase-app-template/*         /index.html     200

# Lovable deployment at root path
# These rules are checked for non-base-path requests
/assets/*  /assets/:splat  200
/*.js      /:splat.js      200
/*.css     /:splat.css     200

# Fallback: Always serve index.html for app routes
/*         /index.html     200