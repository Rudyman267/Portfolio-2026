{
  "name": "shared-hardware-controls",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/hardware-controls/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:util"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared/hardware-controls",
        "main": "libs/shared/hardware-controls/src/keyboard/index.ts",
        "tsConfig": "libs/shared/hardware-controls/tsconfig.json",
        "assets": ["libs/shared/hardware-controls/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/shared/hardware-controls/**/*.ts"]
      }
    }
  }
}
